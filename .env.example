## Core service configuration
PORT=5000
MONGO_URI=mongodb://mongo:27017/linkerly
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_SHORT_BASE_URL=http://localhost:5000

## Auth
JWT_SECRET=replace-me-with-a-strong-secret

## Optional telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318/v1/traces
OTEL_SERVICE_NAME=linkerly-service

## Optional email webhook for password resets
EMAIL_WEBHOOK_URL=

## Optional ImageKit config (uploads)
IMAGEKIT_PUBLIC_KEY=replace-me
IMAGEKIT_PRIVATE_KEY=replace-me
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/replace-me
